# ---------------------------------------------------------------
# Discord Signal Bot — configuration template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ---------------------------------------------------------------

# BloFin API credentials — LIVE
# Get from: https://blofin.com → Account → API Management
BloFinAPI=your_live_blofin_api_key
Blofin_secret_key=your_live_blofin_secret_key
Passphrase=your_live_blofin_passphrase

# BloFin API credentials — DEMO
# Demo issues SEPARATE keys from live. Get from: https://demo-trading.blofin.com
#   → API Management (different key/secret/passphrase than the live site).
# When BLOFIN_BASE_URL points at the demo endpoint, the bot automatically uses
# these Demo-* keys; on the live endpoint it uses the live keys above.
Demo-BloFinAPI=your_demo_blofin_api_key
Demo-Blofin_secret_key=your_demo_blofin_secret_key
Demo-Passphrase=your_demo_blofin_passphrase

# BloFin endpoint — selects which credential set (above) is used.
# Demo (safe for testing): https://demo-trading-openapi.blofin.com
# Live (real money):        https://openapi.blofin.com
BLOFIN_BASE_URL=https://demo-trading-openapi.blofin.com

# Your local timezone offset from UTC used for all log and DB timestamps.
# CDT (Central Daylight, summer): -5   CST (Central Standard, winter): -6
# EDT (Eastern Daylight, summer): -4   EST (Eastern Standard, winter): -5
TZ_OFFSET_HOURS=-5

# Filter notifications to a specific Discord server by name (substring match).
# Set to the exact server name shown in Discord — only messages from this server
# will be processed. Leave blank to process notifications from all servers.
DISCORD_SERVER_FILTER=Unity Academy

# Comma-separated list of Discord analyst display names whose trades will be executed.
# Messages from all analysts in the server are parsed and logged; only whitelisted
# analysts trigger actual order placement.
ANALYST_WHITELIST=Soul Alerts,Prestige Alerts,Sveezy Alerts,Caleb Alerts,Nurse-Neil Alerts,Sherlock Alerts,Wilsauce Alerts,Badillusion Alerts,Ajmal Alerts,Grasady Alerts,Neilarora Alerts

# Local LLM fallback for signal parsing (LM Studio default settings).
# Leave as-is if running LM Studio on the same machine.
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=qwen3.5-9b

# Vision model for extracting price levels from attached chart screenshots.
# Load a vision-capable model in LM Studio (e.g. Qwen2.5-VL-7B).
# Leave blank to disable vision parsing (auto-TP from DEFAULT_RR will be used instead).
LOCAL_VISION_MODEL=qwen2.5-vl-7b

# Risk per trade as a fraction of account balance (0.01 = 1%)
RISK_PCT=0.01

# Maximum number of concurrent open positions (enforced only when HEDGE_MODE=false).
MAX_OPEN_POSITIONS=3

# Per-source cap on concurrent open positions, used in HEDGE_MODE only. Hedge mode
# relaxes the global MAX_OPEN_POSITIONS so every source tests its signals in
# parallel; this bounds any single chatty source (e.g. RSI Extreme firing several
# alerts at once) from opening unbounded concurrent positions. 0 = unlimited
# (current data-gathering behaviour). Recommended ~5 before live trading.
MAX_OPEN_PER_SOURCE=0

# Hedge mode. false = one position per symbol (a second source's signal on an
# already-open symbol is skipped). true = each source (each analyst, RSI,
# OracleAlgo) holds its OWN position per symbol, and opposing long/short can
# coexist — so testing all strategies never skips a signal, and MAX_OPEN_POSITIONS
# is not enforced. NOTE: in dry-run this is purely virtual. For LIVE hedging you
# must also enable BloFin's long_short position mode (not yet automated).
HEDGE_MODE=true

# Adaptive per-analyst leverage (cross margin). Every analyst starts at
# LEVERAGE_START and earns their leverage by performance: each winning trade
# adds LEVERAGE_STEP, each loser subtracts it, clamped to [LEVERAGE_MIN,
# LEVERAGE_MAX]. Stored per-analyst in the DB and persists across restarts.
# Requested leverage is also clamped to each instrument's exchange max.
# Leverage does NOT change per-trade risk — the stop-loss does (RISK_PCT).
LEVERAGE_START=75
LEVERAGE_MIN=50
LEVERAGE_MAX=125
LEVERAGE_STEP=10

# How often to run a full inbox sweep and re-inject the MutationObserver, in seconds.
# Real-time delivery is instant via CDP — this is just a safety-net fallback.
POLL_INTERVAL=300

# Stale-selector escalation. If this many consecutive sweeps parse ZERO inbox
# cards, the Discord DOM has likely changed (or the tab is wedged) and signals are
# being silently missed. The bot then forces a full inbox re-open + observer
# re-inject and fires a single de-duped alert. Clears automatically once a sweep
# parses cards again.
STALE_SWEEP_ALERT_N=3

# Rotating log file size cap. bot.log rotates at LOG_MAX_MB megabytes, keeping
# LOG_BACKUP_COUNT old files (bot.log.1 .. bot.log.N), so it can't grow unbounded
# on long unattended runs.
LOG_MAX_MB=10
LOG_BACKUP_COUNT=5

# How often (seconds) to manage open positions: mark-to-market unrealized PnL and
# check TP/SL/scale-out. Runs off the live WS price cache, so it's cheap to run often.
RESOLVE_INTERVAL=10
# Max age (seconds) of a cached WS price before falling back to a REST lookup.
PRICE_MAX_AGE=15

# Safety switch — keeps the bot in simulation mode (no real orders placed).
# Change to false only when you are ready for live execution.
DRY_RUN=true

# Risk:reward ratio used to auto-calculate TP when an analyst omits it.
# 2.0 = TP placed at 2x the distance from entry to SL.
DEFAULT_RR=2.0

# OracleAlgo "RSI Extreme" mean-reversion strategy.
#   Oversold   → market LONG  (expecting a bounce)
#   Overbought → market SHORT (expecting a pullback)
# Entry is the live price when the alert fires; SL/TP are set as fixed
# percentages around it. Tracked as its own analyst ("RSI Extreme") with its
# own adaptive leverage. Set RSI_EXTREME_ENABLED=false to log but not trade them.
RSI_EXTREME_ENABLED=true
RSI_TP_PCT=0.10
RSI_SL_PCT=0.05

# RSI scale-out ladder — overrides the single RSI_TP_PCT above. Same engine the
# analyst/Oracle trades use: equal slice at each rung + SL ratchet (BE after the
# first, then prior rung). "0.05,0.10" = half off at +5% with SL→break-even, the
# remainder closed at +10%.
RSI_TP_PCTS=0.05,0.10

# First-alert gate: only trade the FIRST RSI alert per symbol per rolling 24h.
# Repeat alerts mean the extreme is extending (the fade keeps failing) — measured
# outcomes ran 80% WR on first alerts vs 38% on repeats. Blocked repeats are still
# shadow-logged (with repeat_n) so the evidence keeps accumulating while gated.
RSI_FIRST_ALERT_ONLY=true

# RSI quality filters (measure-then-tune). Default OFF = each filter's verdict is
# written to strategy_shadow.csv but does NOT block trades, so you can tune the
# thresholds from real dry-run data first. Flip RSI_FILTERS_ENABLED=true to enforce.
#   RSI_MIN_STRENGTH  — only fade genuine extremes: overbought must read >= this,
#                       oversold <= (100 - this). 80 ignores weak 70/30 touches.
#   RSI_MAX_CHASE_PCT — don't fade INTO a strong move: skip an oversold-long when the
#                       coin is already down more than this over 24h (falling knife),
#                       or an overbought-short when it's already up more than this.
RSI_FILTERS_ENABLED=false
RSI_MIN_STRENGTH=80
RSI_MAX_CHASE_PCT=0.12

# Regime gate (separate flag): skip an oversold-long while the OracleAlgo BTC bias is
# bearish (and an overbought-short while it's bullish) — mean-reversion only in chop.
RSI_REGIME_GATE=false

# Confirmation-on-turn: instead of market-entering the instant RSI is extreme (which
# caused the early losses — catching a falling knife), wait for price to start
# reverting. When enabled, the alert ARMS a pending entry that fills only once price
# has moved RSI_CONFIRM_REVERT_PCT back in the trade's favour, expiring after the window.
RSI_CONFIRM_ENABLED=false
RSI_CONFIRM_REVERT_PCT=0.005
RSI_CONFIRM_WINDOW_MIN=30

# For chart-image signals where SL/TP are read by the vision model: reject the
# trade if a read level is more than this fraction away from the live entry
# (a misread chart axis is the usual cause). 0.5 = 50%.
VISION_MAX_DEVIATION_PCT=0.5

# OracleAlgo BTC structure/momentum strategy (MSS/BOS/Supertrend/Delta alerts).
# 4H signals set the BTC bias; 1H signals enter only when they agree with it.
# SL is a fixed % stop; ORACLE_TP_PCTS is the scale-out ladder (equal slice +
# SL ratchet at each). "0.02,0.04" = take 50% at +2%, 50% at +4%, SL→break-even
# after the first. Tracked as its own analyst ("OracleAlgo") with adaptive leverage.
ORACLEALGO_ENABLED=true
ORACLE_SL_PCT=0.015
ORACLE_TP_PCTS=0.02,0.04

# OracleAlgo entry gating.
#   ORACLE_BIAS_TTL_HOURS — a 4H bias older than this is treated as stale, so a 1H
#                           entry won't fire off hours-old context. 0 disables expiry.
#   ORACLE_CONFLUENCE_N    — require this many DISTINCT aligned 1H signal types (MSS,
#                           BOS, Supertrend, Delta) within the window before entering.
#                           1 = today's behaviour (any single aligned signal enters).
#   ORACLE_PULLBACK_PCT    — >0 enters on a limit pullback this far better than the
#                           signal price (better R:R on the tight stop) instead of a
#                           market fill; the pending entry expires after the window.
#                           0 = market entry (off).
ORACLE_BIAS_TTL_HOURS=8
ORACLE_CONFLUENCE_N=1
ORACLE_CONFLUENCE_WINDOW_MIN=45
ORACLE_PULLBACK_PCT=0
ORACLE_PULLBACK_WINDOW_MIN=20

# HTF regime fallback for OracleAlgo 1H entries: when no text-parsed 4H
# OracleAlgo signal has set the bias, derive BTC macro direction from a
# computed 4H ADX regime (EMA20 vs EMA50) using Gate.io public candles.
# Only enters if BTC is in a trending regime (ADX>25) and direction agrees
# with the 1H signal side — protects against trading Oracle signals in chop.
# Annotated in the shadow log as "htf_bull"/"htf_bear" (vs "bull"/"bear" for
# text-parsed bias) so the two sources are distinguishable in analyze_shadow.py.
ORACLE_HTF_FALLBACK=true

# ADX period for market regime detection (symbol's own 1H ADX for RSI quality
# shadow fields; BTC 4H ADX for Oracle HTF context).  14 is Wilder's standard.
ADX_PERIOD=14

# Strategy "measure-then-tune" shadow log. Every RSI/Oracle signal writes one row to
# strategy_shadow.csv with the alert's data (RSI value, 24h change, signal type), the
# current BTC regime, and what each proposed filter WOULD have decided — even while the
# filters are disabled. Review it to tune thresholds before turning the filters on.
STRATEGY_SHADOW_LOG=true

# Cost model for dry-run PnL realism (live trades use the exchange's real fees when
# available). Effective taker fee = FEE_TAKER_PCT * (1 - FEE_REBATE_PCT) and is charged
# on entry and each exit slice; FUNDING_ENABLED accrues perp funding for positions held
# across BloFin's 8h funding marks. BloFin pays a 50% fee cashback → FEE_REBATE_PCT=0.5.
FEE_TAKER_PCT=0.0006
FEE_REBATE_PCT=0.5
FUNDING_ENABLED=true

# Live exchange reconciliation: how often (minutes) to compare the local DB against
# BloFin's actual open positions, settling any that closed/liquidated externally and
# warning about untracked manual trades. Ignored in dry-run.
EXCHANGE_RECON_MIN=15

# Resting-limit staleness sweep. A dry-run limit entry rests in the pending queue
# with no time expiry until price trades through it. This sweep retires one the
# market has clearly left behind: drop it once price has run more than
# LIMIT_STALE_PCT past the limit (so it will realistically never fill), or once it
# is older than LIMIT_STALE_HOURS. Set either threshold to 0 to disable that half.
LIMIT_STALE_PCT=0.10
LIMIT_STALE_HOURS=48

# Runner time-stop for FILLED positions (distinct from the resting-limit sweep
# above). A position that has rested far past its useful life -- typically a TP1
# runner ratcheted to break-even that never reached its final target -- ties up a
# slot and drifts from the original signal thesis. Once a filled position exceeds
# RUNNER_MAX_AGE_HOURS it is closed at market; it counts as a win if any TP was
# already banked (protected at break-even or better), else a loss. 0 = disable.
RUNNER_MAX_AGE_HOURS=120

# POI watchlist: catch an analyst's "future area of interest" (a level they're
# eyeing but haven't entered), read the zone off the attached chart via vision,
# monitor price, ARM + alert when the level is reached, then take their entry
# confirmation. POI_TOLERANCE_PCT = how close price must get to count as reached;
# WATCH_EXPIRY_HOURS = drop a watch that never triggers.
POI_ENABLED=true
POI_TOLERANCE_PCT=0.005
WATCH_EXPIRY_HOURS=72

# Optional: Discord webhook URL for failure alerts (listener down, CDP dropped,
# balance unavailable). Create one in any Discord channel → Edit Channel →
# Integrations → Webhooks. Leave blank to only log alerts.
ALERT_WEBHOOK_URL=

# Dashboard password protection. REQUIRED before exposing the dashboard publicly
# (e.g. via a Cloudflare tunnel) — it shows your balance, positions and PnL.
# Set DASHBOARD_PASSWORD to enable HTTP Basic Auth; leave blank for no auth
# (safe only for purely local/LAN use). Username defaults to "viewer".
DASHBOARD_USER=viewer
DASHBOARD_PASSWORD=

# Oracle Aggregator API. Read-only JSON feeds under /api/oracle/* consumed by
# the unity-oracle-aggregator app. Set a long random shared secret to ENABLE
# the API (it stays OFF — 503 — while blank, since it exposes signals/positions).
# The same value goes in the oracle app's BOT_API_TOKEN.
#   e.g. ORACLE_API_TOKEN=$(openssl rand -hex 32)
ORACLE_API_TOKEN=
